# Render 대시보드 → Environment 에 아래 키들을 등록하세요. 이 파일 자체는 값 없이 형식만 보여주는 예시이며,
# 실제 키가 담긴 .env 파일은 git에 커밋하지 마세요.

# Supabase 대시보드 → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role 키 (절대 프런트엔드나 공개 저장소에 넣지 말 것)

# Vercel 배포 후 발급되는 프런트엔드 주소. 여러 개면 쉼표로 구분.
ALLOWED_ORIGIN=https://suj-form.vercel.app

PORT=3000
